generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  password      String
  name          String
  email         String   @unique
  role          String   @default("user") // admin, technician, user
  roleId        String   @default("user")
  position      String?
  department    String?
  departmentId  String?
  avatar        String?
  isActive      Boolean  @default(true)
  isOnline      Boolean  @default(false)
  notificationsEnabled Boolean @default(false)
  aiEnabled     Boolean  @default(true)
  showGreeting  Boolean  @default(false)
  greetingText  String   @default("Шо ты маленький, привет")
  avatarHistory String[] @default([])
  createdAt     DateTime @default(now())
  lastLogin     DateTime?
  
  // Relations
  ticketsCreated  Ticket[] @relation("CreatedBy")
  ticketsAssigned Ticket[] @relation("AssignedTo")
  comments        Comment[]
  documents       Document[]
  kbArticles      KBArticle[]
  sentMessages    ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  aiHistory       AIHistory[]
  
  // Role Relation
  roleRelation    Role?    @relation(fields: [roleId], references: [id])
  departmentRelation Department? @relation(fields: [departmentId], references: [id])
}

model Role {
  id          String   @id
  name        String
  description String
  color       String
  isSystem    Boolean  @default(false)
  permissions Json     // Store ModulePermission[] as JSON
  users       User[]
}

model Building {
  id        String    @id @default(uuid())
  name      String    @unique
  order     Int       @default(0)
  width     Int?      @default(0) // Width in percentage or specific unit, 0 means auto
  floors    Floor[]
  cabinets  Cabinet[]
  equipment Equipment[]
}

model Floor {
  id         String    @id @default(uuid())
  number     Int
  buildingId String
  building   Building  @relation(fields: [buildingId], references: [id])
  cabinets   Cabinet[]
  equipment  Equipment[]
}

model Equipment {
  id              String   @id @default(uuid())
  name            String
  model           String
  serialNumber    String?
  inventoryNumber String?
  tag             String?
  comment         String?
  fileUrl         String?
  status          String   @default("active") // active, repair, broken, retired
  
  cabinetId       String?
  cabinet         Cabinet? @relation(fields: [cabinetId], references: [id])
  buildingId      String?
  building        Building? @relation(fields: [buildingId], references: [id])
  floorId         String?
  floor           Floor?    @relation(fields: [floorId], references: [id])
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?
  color     String?
  users     User[]
  entries   DirectoryEntry[]
  cabinets  Cabinet[]
  equipment Equipment[]
}

model RegistrationRequest {
  id          String   @id @default(uuid())
  name        String
  email       String
  department  String
  reason      String
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now())
}

model Ticket {
  id          String   @id @default(uuid())
  number      String   @unique
  title       String
  description String
  category    String
  priority    String   @default("medium") // low, medium, high, critical
  status      String   @default("new") // new, in_progress, waiting, resolved, closed
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  authorId    String
  author      User     @relation("CreatedBy", fields: [authorId], references: [id])
  assigneeId  String?
  assignee    User?    @relation("AssignedTo", fields: [assigneeId], references: [id])
  comments    Comment[]
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())
  
  // Relations
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

model Document {
  id                String   @id @default(uuid())
  number            String   @unique
  title             String
  type              String   // act, repair, maintenance, inventory
  status            String   @default("active") // active, archived
  description       String?
  equipmentName     String?
  equipmentLocation String?
  repairDate        DateTime?
  repairCost        Float    @default(0)
  partsUsed         Json?    // Array of strings or complex objects
  files             Json?    // Array of { name, url, size }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  authorId          String
  author            User     @relation(fields: [authorId], references: [id])
}

model InventoryItem {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  category    String
  description String?
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  unit        String   @default("pcs")
  location    String?
  supplier    String?
  price       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DirectoryEntry {
  id            String   @id @default(uuid())
  name          String
  position      String?
  department    String?
  departmentId  String?
  cabinet       String?
  internalPhone String?
  mobilePhone   String?
  telegram      String?
  tags          String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  departmentRelation Department? @relation(fields: [departmentId], references: [id])
}

model KBArticle {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  content     String
  category    String
  steps       Json?    @default("[]")
  tags        String[]
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
}

model ChatMessage {
  id          String   @id @default(uuid())
  text        String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  // Relations
  senderId    String?
  sender      User?    @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String?
  receiver    User?    @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model SystemLog {
  id        String   @id @default(uuid())
  type      String   // info, warn, error, request
  message   String
  user      String   @default("Anonymous")
  timestamp DateTime @default(now())
  details   Json?
}

model Cabinet {
  id            String      @id @default(uuid())
  name          String
  order         Int         @default(0)
  floorId       String?
  floor         Floor?      @relation(fields: [floorId], references: [id])
  buildingId    String?
  building      Building?   @relation(fields: [buildingId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  equipment     Equipment[]
}

model AIHistory {
  id        String   @id @default(uuid())
  message   String
  reply     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
